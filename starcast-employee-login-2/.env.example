# ==============================================================================
# StarCast Online - Environment Configuration Template
# Copy this file to .env.local for local development.
# Configure these variables in Netlify > Site configuration > Environment variables.
# ==============================================================================

# --- DATABASE (Neon PostgreSQL) -----------------------------------------------
# In your Neon console, copy the standard Postgres wire URL:
# Format: postgresql://[user]:[password]@[neon-hostname].neon.tech/[dbname]?sslmode=require
DATABASE_URL="postgresql://username:password@your-neon-host.neon.tech/neondb?sslmode=require"

# Also accepted by the app and Drizzle if using Netlify's Neon integration:
NETLIFY_DATABASE_URL="postgresql://username:password@your-neon-host.neon.tech/neondb?sslmode=require"

# --- AUTH (Better Auth) -------------------------------------------------------
# Random secret for signing session cookies
BETTER_AUTH_SECRET="your-better-auth-secret-here"

# The canonical base URL of the site:
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- EMAIL (Resend) -----------------------------------------------------------
# API key from resend.com:
RESEND_API_KEY="your-resend-api-key-here"

# --- SMS (Twilio) -------------------------------------------------------------
# Twilio credentials for sending phone verification OTP codes:
TWILIO_ACCOUNT_SID="your-twilio-account-sid-here"
TWILIO_AUTH_TOKEN="your-twilio-auth-token-here"
TWILIO_FROM_NUMBER="+10000000000"

# --- PAYMENTS & PAYROLL (Stripe) ----------------------------------------------
# Stripe secret & publishable keys for sponsor checkout & payouts:
STRIPE_SECRET_KEY="your-stripe-secret-key-here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your-stripe-publishable-key-here"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret-here"

# --- CRON & BACKGROUND JOBS ---------------------------------------------------
# Secret bearer token to protect /api/cron/* endpoints:
CRON_SECRET="your-cron-secret-here"

# --- YOUTUBE INTEGRATION (Optional) -------------------------------------------
# Google API key for YouTube channel & playlist feeds:
YOUTUBE_API_KEY=""
