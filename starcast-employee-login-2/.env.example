# ==============================================================================
# StarCast Online - Environment Configuration Template
# Copy this file to .env.local for local development.
# Production secrets configured in Google Secret Manager & apphosting.yaml
# ==============================================================================

# --- DATABASE (PostgreSQL) ----------------------------------------------------
# Standard Postgres wire URL (Cloud SQL or managed Postgres):
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]?sslmode=require
DATABASE_URL="postgresql://username:password@localhost:5432/starcast?sslmode=require"

# --- AUTH (Better Auth) -------------------------------------------------------
# Random secret for signing session cookies
BETTER_AUTH_SECRET="your-better-auth-secret-here"

# The canonical base URL of the site:
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- EMAIL (Resend) -----------------------------------------------------------
# API key from resend.com:
RESEND_API_KEY="your-resend-api-key-here"

# --- SMS (Twilio) -------------------------------------------------------------
# Twilio credentials for sending phone verification OTP codes:
TWILIO_ACCOUNT_SID="your-twilio-account-sid-here"
TWILIO_AUTH_TOKEN="your-twilio-auth-token-here"
TWILIO_FROM_NUMBER="+10000000000"

# --- PAYMENTS & PAYROLL (Stripe) ----------------------------------------------
# Stripe secret & publishable keys for sponsor checkout & payouts:
STRIPE_SECRET_KEY="your-stripe-secret-key-here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="your-stripe-publishable-key-here"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret-here"

# --- CRON & BACKGROUND JOBS ---------------------------------------------------
# Secret bearer token to protect /api/cron/* endpoints:
CRON_SECRET="your-cron-secret-here"

# --- YOUTUBE INTEGRATION (Optional) -------------------------------------------
# Google API key for YouTube channel & playlist feeds:
YOUTUBE_API_KEY=""

# --- SHOPIFY STOREFRONT (Merch & Shop) ----------------------------------------
# Store domain (e.g. starcastonline.myshopify.com or shop.starcast.online)
SHOPIFY_STORE_DOMAIN="starcastonline.myshopify.com"
# Storefront API Access Token (created in Shopify Admin > Sales Channels / Headless / Storefront API)
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
# Optional custom shop web URL if different from domain
NEXT_PUBLIC_SHOPIFY_STORE_URL="https://starcastonline.myshopify.com"

